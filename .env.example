# GitHub MCP
GITHUB_TOKEN=ghp_your_token_here

# Google Drive & Docs MCP
# Path to the OAuth2 credentials.json downloaded from Google Cloud Console
# Steps: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID (Desktop)
# Enable APIs: Google Drive API + Google Docs API
# Download credentials.json → place it at the path below (never commit it)
GOOGLE_CREDENTIALS_PATH=.credentials/google.json

# Google Slides MCP (google-slides-mcp by matteoantoci)
# Mismas credenciales OAuth2 del proyecto de Google Cloud que usa Drive arriba
# GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET: cópialos desde .credentials/google.json
# GOOGLE_REFRESH_TOKEN: obtenerlo UNA VEZ con el script:
#   npx google-slides-mcp get-token
# Requiere que Google Slides API esté habilitada en el mismo proyecto de Cloud Console
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# PostgreSQL MCP
POSTGRES_URL=postgresql://user:password@localhost:5432/dbname

# Redis MCP
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Datadog custom MCP
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key
DD_SITE=datadoghq.com

# Playwright agents
STAGING_URL=https://staging.yourapp.com
MONITORED_URLS=https://yourapp.com,https://api.yourapp.com

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Google Maps MCP (@cablate/mcp-google-map)
# Usado para buscar prospectos de venta por categoría/ciudad (skill /sales:find-prospects)
# Steps: console.cloud.google.com → crear proyecto → APIs & Services → Library
# Habilitar: "Places API (New)" (y opcionalmente "Geocoding API")
# Credentials → Create Credentials → API Key → restringir a esas APIs
# OJO: Places API tiene costo por uso pasado el free tier de Google Cloud — revisar pricing
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
